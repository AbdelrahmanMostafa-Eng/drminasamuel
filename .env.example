# ─── Database (PostgreSQL) ───────────────────────────────────────────
# Supabase / Neon / Railway / any Postgres. For Supabase use the "Session pooler" or direct URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bioacademy"

# ─── Security ────────────────────────────────────────────────────────
# Long random string (e.g. `openssl rand -base64 48`). Signs upload tokens.
APP_SECRET="change-me-to-a-long-random-string"

# Public URL of the site (no trailing slash)
APP_URL="http://localhost:3000"

# ─── File storage ────────────────────────────────────────────────────
# "local" = save files on this server's disk (VPS / Docker / local dev)
# "s3"    = any S3-compatible bucket (Cloudflare R2 recommended, Supabase Storage, AWS S3, Backblaze B2)
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage"

# Only needed when STORAGE_DRIVER="s3"
S3_ENDPOINT=""            # e.g. https://<account-id>.r2.cloudflarestorage.com
S3_REGION="auto"
S3_BUCKET="bioacademy"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ─── First master-admin account (used by `npm run db:seed`) ──────────
SEED_MASTER_USERNAME="drmina"
SEED_MASTER_PASSWORD="ChangeMe-2026!"
SEED_MASTER_NAME="Dr. Mina Samuel"
# Set to "false" to skip the example courses / sample students
SEED_SAMPLE_DATA="true"
